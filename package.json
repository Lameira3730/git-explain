{
  "name": "@lameira123/git-explain",
  "version": "1.0.0",
  "description": "CLI that explains Git diffs in human language using AI.",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "git-explain": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lameira3730/git-explain.git"
  },
  "keywords": [
    "git",
    "diff",
    "cli",
    "ai",
    "openai",
    "claude",
    "anthropic",
    "gemini",
    "developer-tools"
  ],
  "author": "Goncalo Lameira",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lameira3730/git-explain/issues"
  },
  "homepage": "https://github.com/Lameira3730/git-explain#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "inquirer": "^14.0.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^7.4.0",
    "ora": "^9.4.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
